fxy <- function(x,y){
ifelse(x>=0 & x<=1 & y>=0 & y<=1,1,0)
}
fxy(0.5,0.7)
prob_b <- integrate(function(x){
sapply(x,function(x){
integrate(function(y){
fxy(x,y)
},0,1)$value
})
},0,1)
prob_b$value
