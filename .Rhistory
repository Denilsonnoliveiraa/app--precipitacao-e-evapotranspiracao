# 1. PACOTES
# =========================
library(terra)
library(sf)
library(dplyr)
library(ggplot2)
library(purrr)
library(openxlsx)
# =========================
# 2. ANOS E CAMINHOS
# =========================
anos <- c(1985, 1990, 1995, 2000, 2005, 2010, 2015, 2020, 2024)
base_dir <- "D:/MATERIAL DA ANÁLISE/BASE DE DADOS/DADOS PARA VEGETAÇÃO"
caminhos <- paste0(
base_dir, "/base ", anos,
"/brazil_coverage_", anos, ".tif"
)
print(caminhos)  # conferir
# =========================
# 3. SHAPE
# =========================
shape = "C:/Users/Denilson/Desktop/mapas/Cariri_Completo.shp"
# =========================
# 4. MAPA DE CLASSES
# =========================
mapa_classes <- c(
"3"="Floresta","4"="Savana","5"="Mangue","6"="Floresta Alagável","49"="Restinga Arbórea",
"10"="Vegetação Herbácea","11"="Área Alagada","12"="Campestre","32"="Apicum","29"="Afloramento Rochoso","50"="Restinga Herbácea",
"14"="Agropecuária","15"="Pastagem","18"="Agricultura","19"="Lavoura Temporária","39"="Soja",
"20"="Cana","40"="Arroz","62"="Algodão","41"="Outras Temporárias",
"36"="Lavoura Perene","46"="Café","47"="Citrus","35"="Dendê","48"="Outras Perenes",
"9"="Silvicultura","21"="Mosaico de Usos",
"22"="Área Não Vegetada","23"="Praia/Duna","24"="Área Urbana","30"="Mineração","25"="Outras Não Vegetadas",
"26"="Água","33"="Rio/Oceano","31"="Aquicultura"
)
# =========================
# 5. FUNÇÃO
# =========================
processar <- function(caminho, ano){
if(!file.exists(caminho)) return(NULL)
r <- rast(caminho)
shp <- st_transform(shape, crs(r))
r_mask <- mask(crop(r, vect(shp)), vect(shp))
df <- as.data.frame(r_mask, xy = TRUE)
colnames(df)[3] <- "valor"
df <- df %>%
mutate(
classe = mapa_classes[as.character(valor)],
ano = ano
) %>%
filter(!is.na(classe))
# resumo por ano
df_resumo <- df %>%
group_by(ano, classe) %>%
summarise(area = n(), .groups = "drop")
return(df_resumo)
}
# =========================
# 6. RODAR TODOS OS ANOS
# =========================
serie <- map2_dfr(caminhos, anos, processar)
# =========================
# 2. CONFIGURAÇÕES
# =========================
anos <- c(1985, 1990, 1995, 2000, 2005, 2010, 2015, 2020, 2024)
base_dir <- "D:/MATERIAL DA ANÁLISE/BASE DE DADOS/DADOS PARA VEGETAÇÃO"
shape_path = "C:/Users/Denilson/Desktop/mapas/Cariri_Completo.shp"
# =========================
# 3. VERIFICAÇÃO SHAPE
# =========================
if(!file.exists(shape_path)){
stop("❌ Shape não encontrado. Verifique o caminho.")
}
shape <- st_read(shape_path)
# =========================
# 4. MAPA DE CLASSES
# =========================
mapa_classes <- c(
"3"="Floresta","4"="Savana","5"="Mangue","6"="Floresta Alagável","49"="Restinga Arbórea",
"10"="Vegetação Herbácea","11"="Área Alagada","12"="Campestre","32"="Apicum","29"="Afloramento Rochoso","50"="Restinga Herbácea",
"14"="Agropecuária","15"="Pastagem","18"="Agricultura","19"="Lavoura Temporária","39"="Soja",
"20"="Cana","40"="Arroz","62"="Algodão","41"="Outras Temporárias",
"36"="Lavoura Perene","46"="Café","47"="Citrus","35"="Dendê","48"="Outras Perenes",
"9"="Silvicultura","21"="Mosaico de Usos",
"22"="Área Não Vegetada","23"="Praia/Duna","24"="Área Urbana","30"="Mineração","25"="Outras Não Vegetadas",
"26"="Água","33"="Rio/Oceano","31"="Aquicultura"
)
# =========================
# 5. FUNÇÃO PRINCIPAL
# =========================
processar <- function(ano){
caminho <- paste0(
base_dir, "/base ", ano,
"/brazil_coverage_", ano, ".tif"
)
if(!file.exists(caminho)){
message(paste("⚠️ Arquivo não encontrado:", ano))
return(NULL)
}
r <- rast(caminho)
shp <- st_transform(shape, crs(r))
r_mask <- mask(crop(r, vect(shp)), vect(shp))
df <- as.data.frame(r_mask, xy = TRUE)
colnames(df)[3] <- "valor"
df <- df %>%
mutate(
classe = mapa_classes[as.character(valor)],
ano = ano
) %>%
filter(!is.na(classe))
df %>%
group_by(ano, classe) %>%
summarise(area = n(), .groups = "drop")
}
# =========================
# 6. RODAR SÉRIE TEMPORAL
# =========================
serie <- map_dfr(anos, processar)
# =========================
# 7. TOP CLASSES (EVITA POLUIÇÃO)
# =========================
top_classes <- serie %>%
group_by(classe) %>%
summarise(total = sum(area)) %>%
slice_max(total, n = 6) %>%
pull(classe)
serie_filtrada <- serie %>%
filter(classe %in% top_classes)
# =========================
# 8. GRÁFICO FINAL
# =========================
grafico <- ggplot(serie_filtrada, aes(x = ano, y = area, color = classe)) +
geom_line(linewidth = 1.2) +
geom_point(size = 2) +
labs(
title = "Série Temporal - Uso e Cobertura do Solo (Recife)",
x = "Ano",
y = "Área (pixels)",
color = "Classe"
) +
theme_minimal() +
theme(
plot.title = element_text(size = 14, face = "bold"),
legend.position = "right"
)
grafico
