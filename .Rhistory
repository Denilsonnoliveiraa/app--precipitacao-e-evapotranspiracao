# 1. CARREGAMENTO E PREPARAÇÃO
data("diamonds")
install.packages("tidymodels")
install.packages("tidymodels")
# 1. CARREGAMENTO E PREPARAÇÃO
data("diamonds")
diamonds_class <- diamonds %>%
mutate(preco_cat = factor(ntile(price, 3), labels = c("Baixo", "Medio", "Alto"))) %>%
dplyr::select(-price)
# 2. LOOP INTERATIVO DE ANÁLISE
repeat {
cat("\n==================================================")
cat("\n--- ESCOLHA O MODELO DE MACHINE LEARNING ---")
cat("\n1. Random Forest")
cat("\n2. XGBoost")
cat("\n3. Regressão Multinomial")
cat("\n4. Naive Bayes (Default)")
cat("\n5. Gaussian Naive Bayes")
cat("\n6. Triangular Naive Bayes")
cat("\n==================================================\n")
escolha <- readline(prompt = "Digite o número da opção desejada: ")
# Seleção do Modelo
if (escolha == "1") {
modelo_espec <- rand_forest(mode = "classification") %>% set_engine("ranger")
} else if (escolha == "2") {
modelo_espec <- boost_tree(mode = "classification") %>% set_engine("xgboost", verbose = 0)
} else if (escolha == "3") {
modelo_espec <- multinom_reg() %>% set_engine("nnet", MaxNWts = 2000)
} else if (escolha == "4") {
modelo_espec <- naive_Bayes(mode = "classification") %>% set_engine("naivebayes")
} else if (escolha == "5") {
modelo_espec <- naive_Bayes(mode = "classification") %>% set_engine("klaR")
} else if (escolha == "6") {
# Triangular Naive Bayes via engine 'naivebayes' com kernel triangular
modelo_espec <- naive_Bayes(mode = "classification") %>%
set_engine("naivebayes", usekernel = TRUE, kernel = "triangular")
} else {
cat("\n[ERRO] Opção inválida!\n")
next
}
# 3. PIPELINE DE TREINO E AVALIAÇÃO
cat("\nTreinando o modelo selecionado...\n")
meu_workflow <- workflow() %>% add_model(modelo_espec) %>% add_formula(preco_cat ~ .)
modelo_fit <- fit(meu_workflow, data = diamonds_class)
# Predições e Resultados
pred <- predict(modelo_fit, diamonds_class) %>% bind_cols(diamonds_class)
cat("\n--- Métricas de Performance ---\n")
print(metrics(pred, truth = preco_cat, estimate = .pred_class))
cat("\n--- Matriz de Confusão (Visual) ---\n")
print(conf_mat(pred, truth = preco_cat, estimate = .pred_class) %>%
autoplot(type = "heatmap") + labs(title = paste("Heatmap - Modelo:", escolha)))
if (tolower(readline(prompt = "\nDeseja testar outro modelo? (s/n): ")) != "s") break
}
